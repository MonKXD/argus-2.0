# ARGUS AI environment template.
# Copy to .env.local and fill in. Never commit .env.local or real credentials.
# src/lib/env.ts validates these at startup and fails fast on missing or invalid values.

# ---------- App ----------
APP_URL=http://localhost:3000
LOG_LEVEL=info
SESSION_COOKIE_NAME=argus_session
SESSION_MAX_AGE_DAYS=5

# ---------- LLM provider (server only) ----------
# "gemini" (default, free tier) or "anthropic". Only the active provider's
# own vars below are required (src/lib/env.ts validates this).
LLM_PROVIDER=gemini

# ---------- Gemini (server only) ----------
GEMINI_API_KEY=
# Model IDs by role. Check https://ai.google.dev/gemini-api/docs/models for current model IDs
# before changing. gemini-flash-latest (a "thinking" model) hit real, consistent 503 overload
# on forced function calls during live verification (PROJECT_MEMORY D-065) — gemini-flash-lite-latest
# is used for every role until that clears.
GEMINI_MODEL_ANALYSIS=gemini-flash-lite-latest
GEMINI_MODEL_SYNTHESIS=gemini-flash-lite-latest
GEMINI_MODEL_FAST=gemini-flash-lite-latest

# ---------- Anthropic (server only) ----------
ANTHROPIC_API_KEY=
# Model IDs by role. Check https://docs.claude.com for current model IDs before changing.
ANTHROPIC_MODEL_ANALYSIS=claude-sonnet-5
ANTHROPIC_MODEL_SYNTHESIS=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# ---------- Firebase web config (public) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Mirrors USE_FIREBASE_EMULATORS below, for the browser-side client SDK.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# ---------- Firebase Admin (server only) ----------
FIREBASE_PROJECT_ID=
# Mirrors NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET above, for the Admin SDK.
FIREBASE_STORAGE_BUCKET=
# CLIENT_EMAIL and PRIVATE_KEY are only required when USE_FIREBASE_EMULATORS
# is false (a real Firebase project). Leave both blank for emulator-only dev.
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences inside the quoted key.
FIREBASE_PRIVATE_KEY=

# ---------- Firebase emulators (local development) ----------
USE_FIREBASE_EMULATORS=true
# Default emulator ports shown; adjust if your firebase.json differs.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ---------- Limits ----------
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=100
DAILY_ANALYSIS_LIMIT=10
MAX_CONCURRENT_RUNS=2
RUN_TOKEN_BUDGET=600000
ANALYZE_CONCURRENCY=4

# ---------- Feature flags ----------
FEATURE_WEB_RESEARCH=true
FEATURE_MONITORING=false
